{
  "name": "lit-dev-api",
  "private": true,
  "version": "0.0.0",
  "description": "Api docs for lit.dev",
  "author": "Google LLC",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "command": "node ../lit-dev-tools-cjs/lib/api-docs/generate.js",
      "dependencies": [
        "../lit-dev-tools-cjs:build",
        "../../../packages/lit:build:ts:types"
      ],
      "files": [
        "../../../packages/{lit,lit-element,lit-html,reactive-element}/src/**/*.ts"
      ],
      "#comment": [
        "Lit 3 API docs are generated from this monorepo's own packages (built by",
        "the dependency above). Lit 2 is still cloned at a pinned commit into",
        "api-data/lit-2/repo, which we don't declare as output because it's huge."
      ]
    }
  },
  "dependencies": {
    "lit-dev-tools-cjs": "^0.0.0"
  }
}
