// lit.dev main site, deployed as a Cloudflare Worker with static assets.
//
// Workers Builds settings (root directory: the lit/lit monorepo root `/`):
//   Build command:  npm run build:cloudflare -w lit-dev-content
//   Deploy command: npx wrangler deploy -c website/packages/lit-dev-content/wrangler.jsonc
//   Preview command: npx wrangler preview -c website/packages/lit-dev-content/wrangler.jsonc
// and these build variables:
//   LITDEV_MAIN_URL        Public URL of this Worker, e.g.
//                          https://lit-dev.<subdomain>.workers.dev
//   LITDEV_PLAYGROUND_URL  Public URL of the playground sandbox Worker
//                          (website/packages/lit-dev-playground), e.g.
//                          https://lit-dev-playground.<subdomain>.workers.dev/
{
  "name": "lit-dev",
  "compatibility_date": "2025-11-01",
  "assets": {
    // Generated by `npm run build:cloudflare`. Includes _redirects, _headers
    // and 404.html (see website/packages/lit-dev-server/cloudflare-prepare.mjs).
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview` (Workers Previews). Empty because this
  // Worker has no bindings or vars to override for Previews; assets stay at
  // the top level.
  "previews": {}
}
