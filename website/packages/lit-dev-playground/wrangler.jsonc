// lit.dev Playground sandbox, deployed as a Cloudflare Worker with static
// assets. It must be on a different origin than the main site
// (website/packages/lit-dev-content/wrangler.jsonc).
//
// Workers Builds settings (root directory: the lit/lit monorepo root `/`):
//   Build command:  npm run build -w lit-dev-playground
//   Deploy command: npx wrangler deploy -c website/packages/lit-dev-playground/wrangler.jsonc
//   Preview command: npx wrangler preview -c website/packages/lit-dev-playground/wrangler.jsonc
{
  "name": "lit-dev-playground",
  "compatibility_date": "2025-11-01",
  "assets": {
    // Generated by `npm run build` (playground-elements plus a _headers file).
    "directory": "./dist",
    // Serve files exactly as named; playground-elements requests .html files.
    "html_handling": "none"
  },
  // Required by `wrangler preview` (Workers Previews). Empty because this
  // Worker has no bindings or vars to override for Previews; assets stay at
  // the top level.
  "previews": {}
}
